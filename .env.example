# Django -> C# API inside Docker network
DJANGO_API_BASE_URL=http://csharp-api:5000/api

# Browser-facing API through nginx
PUBLIC_API_BASE_URL=http://localhost/api
PUBLIC_FRONTEND_URL=http://localhost

DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=esports_db
DB_USER=esports_user
DB_PASSWORD=esports123
DB_HOST=postgres
DB_PORT=5432

# Optional external APIs. Leave empty for offline/local demo.
PANDASCORE_TOKEN=
PANDASCORE_BASE_URL=https://api.pandascore.co
FACEIT_API_KEY=
LIQUIPEDIA_USER_AGENT=EsportsTournamentsStudyProject/1.0

# Discord demo: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
DISCORD_BOT_NAME=Esports Arena

# Optional SMTP. If empty, backend prints verification link into logs instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
