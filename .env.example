# ==========================================
# 🚀 CORE SYSTEM & NETWORK
# ==========================================
# Внутренняя ссылка для обращения Django к C# API (внутри сети Docker)
DJANGO_API_BASE_URL=http://csharp-api:5000/api

# Публичный URL API (через nginx)
PUBLIC_API_BASE_URL=http://localhost/api

# Публичный адрес фронтенда
PUBLIC_FRONTEND_URL=http://localhost

# Внутренняя ссылка на ML сервис
ML_SERVICE_URL=http://ml-service:8001

# Подключение к Redis (для кэша в Django)
REDIS_URL=redis://redis:6379/0

# ==========================================
# 🔒 DJANGO SECURITY SETTINGS
# ==========================================
# Секретный ключ Django (замените на случайную строку в проде)
DJANGO_SECRET_KEY=change-me-for-production
# Режим отладки (в проде обязательно False!)
DJANGO_DEBUG=True
# Разрешенные хосты
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx

# ==========================================
# 🗄️ DATABASE (PostgreSQL)
